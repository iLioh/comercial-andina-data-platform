# Identifiers only. Passwords and access keys must remain in AWS Secrets Manager/IAM.
AWS_REGION=us-east-1
CA_RAW_BUCKET=comercial-andina-data-ACCOUNT_ID-us-east-1
CA_RDS_HOST=replace-me.abcdefgh.us-east-1.rds.amazonaws.com
CA_RDS_DATABASE=comercial_andina
CA_RDS_SECRET_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:REPLACE_ME
CA_REDSHIFT_WORKGROUP=comercial-andina
CA_REDSHIFT_DATABASE=comercial_andina_dw
CA_REDSHIFT_SECRET_ARN=arn:aws:secretsmanager:us-east-1:ACCOUNT_ID:secret:REPLACE_ME
PREFECT_API_URL=https://api.prefect.cloud/api/accounts/REPLACE_ME/workspaces/REPLACE_ME
PREFECT_API_KEY=obtain-at-runtime-from-secrets-manager
