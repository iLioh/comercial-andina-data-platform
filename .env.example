# Non-secret Azure resource identifiers only. Credentials remain in Key Vault.
CA_STORAGE_ACCOUNT=stcadevreplace
CA_RAW_CONTAINER=raw
CA_MANIFEST_CONTAINER=manifests
CA_QUARANTINE_CONTAINER=quarantine
CA_KEY_VAULT_URL=https://kv-ca-dev-replace.vault.azure.net/
CA_POSTGRES_HOST=psql-ca-dev-replace.postgres.database.azure.com
CA_POSTGRES_DATABASE=comercial_andina
CA_POSTGRES_SECRET_NAME=postgres-credentials
CA_SQL_SERVER=sql-ca-dev-replace.database.windows.net
CA_SQL_DATABASE=comercial_andina_dw
CA_SQL_SECRET_NAME=sql-credentials

# Set only in the runtime secret store; never commit real values.
PREFECT_API_URL=https://api.prefect.cloud/api/accounts/ACCOUNT/workspaces/WORKSPACE
PREFECT_API_KEY=replace-at-runtime
